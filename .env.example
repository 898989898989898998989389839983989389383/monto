# Browser deploys can leave this empty for same-origin API calls.
# Android/native builds use https://monto-psi.vercel.app by default.
VITE_API_BASE_URL=

# Server-side admin login. Do not expose these as VITE_* values.
ADMIN_USERNAME=
ADMIN_PASSWORD=
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_PASSWORD=
ADMIN_AUTH_SECRET=

# Google/Gmail SMTP for signup verification and forgot-password OTP emails.
# Use a Gmail app password, not your normal Google account password.
GOOGLE_SMTP_USER=
GOOGLE_SMTP_APP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

# Postgres connection.
DATABASE_URL=
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=
POSTGRES_SSL=true
POSTGRES_SSL_REJECT_UNAUTHORIZED=true
POSTGRES_POOL_MAX=1

# Server-side media upload and CDN delivery.
# Find these values in Cloudinary Console -> API Keys.
CLOUDINARY_URL=cloudinary://[API-KEY]:[API-SECRET]@[CLOUD-NAME]
# Optional alternative to CLOUDINARY_URL:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Separate account used only for uploaded PDF notes.
CLOUDINARY_PDF_URL=cloudinary://[PDF-API-KEY]:[PDF-API-SECRET]@[PDF-CLOUD-NAME]
# Separate account used for course and video thumbnail uploads.
# If empty, thumbnail uploads fall back to CLOUDINARY_ACCOUNT_2_URL, then CLOUDINARY_PDF_URL.
CLOUDINARY_THUMBNAIL_URL=cloudinary://[THUMBNAIL-API-KEY]:[THUMBNAIL-API-SECRET]@[THUMBNAIL-CLOUD-NAME]
CLOUDINARY_ACCOUNT_2_URL=
CLOUDINARY_FOLDER=monto

# Push notification sending from /appcontrol.
# Recommended: paste Firebase service account JSON, or base64-encoded JSON.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Optional fallback for old FCM projects if you still use a server key.
FCM_SERVER_KEY=
